{
	"name": "@vitreakit/svelte",
	"version": "0.1.0",
	"description": "Liquid-glass components for Svelte 5: shadcn-svelte and bits-ui, rebuilt as touchable glass with spring motion.",
	"license": "MIT",
	"author": "Oriol",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm run package",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"files": ["dist", "!dist/**/*.test.*", "!dist/**/*.spec.*"],
	"sideEffects": ["**/*.css"],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./*": {
			"types": "./dist/components/ui/*/index.d.ts",
			"svelte": "./dist/components/ui/*/index.js"
		}
	},
	"dependencies": {
		"@vitreakit/core": "workspace:^",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.31.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0",
		"vaul-svelte": "^1.0.0-next.7"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0",
		"@tanstack/table-core": "^8.0.0",
		"formsnap": "^2.0.0",
		"layerchart": "2.0.0-next.48",
		"sveltekit-superforms": "^2.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/table-core": { "optional": true },
		"formsnap": { "optional": true },
		"layerchart": { "optional": true },
		"sveltekit-superforms": { "optional": true }
	},
	"devDependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/table-core": "^8.21.3",
		"formsnap": "^2.0.1",
		"layerchart": "2.0.0-next.48",
		"publint": "^0.3.0",
		"shadcn-svelte": "^1.4.1",
		"shiki": "^3.13.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"sveltekit-superforms": "^2.30.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"keywords": ["svelte", "svelte5", "components", "ui", "glass", "liquid-glass", "glassmorphism", "tailwindcss", "shadcn-svelte", "bits-ui"]
}
